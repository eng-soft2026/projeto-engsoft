{
  "name": "projeto-engsoft",
  "version": "1.0.0",
  "description": "Projeto da disciplina de Engenharia de Software (UNIFESP).",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:seed": "prisma db seed",
    "db:check": "node --env-file-if-exists=.env scripts/check-mysql-constraints.mjs",
    "smoke": "node --env-file-if-exists=.env scripts/smoke-api.mjs",
    "audit:check": "node scripts/check-npm-audit.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GrazieleUnifesp/projeto-engsoft.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/GrazieleUnifesp/projeto-engsoft/issues"
  },
  "homepage": "https://github.com/GrazieleUnifesp/projeto-engsoft#readme",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.3.8",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "^6.3.0",
    "zod": "^4.6.6"
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "3.5.4"
    }
  }
}
